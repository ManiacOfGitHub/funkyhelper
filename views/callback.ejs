<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>FunkyHelper - Staff Login</title>
        <%- include("partials/bootstrap.ejs") %>
    </head>
    <body>
        <%- include("partials/navbar.ejs") %>
        <div class="container my-5">
            <h1 class="fs-1 text-center">Staff Login</h1>
            <hr>
            <% if (!locals.error) { %>
            <div class="alert alert-primary">Logging you in...</div>
            <script src="/loginCheck.js"></script>
            <% } else { %>
            <h5>An error has occurred:</h5>
            <div class="alert alert-danger"><%= locals.error || "An error has occurred." %></div>
            <p>Please try again later.</p>
            <% } %>
        </div>
    </body>
</html>
